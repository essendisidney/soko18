NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (Vercel): set to the public origin, e.g. https://soko18.vercel.app
# NEXT_PUBLIC_APP_URL=https://soko18.vercel.app

# Optional until you pay for a Supabase project.
# Leave blank — guest discover still works; login shows an honest wait state.
# Never put service_role in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, promotion intents use provider=mpesa and stay pending.
# Sandbox settle is the working rail until Daraja is wired.
# MPESA_SHORTCODE=
